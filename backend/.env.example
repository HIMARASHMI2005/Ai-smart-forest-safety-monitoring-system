# Smart Forest Environment Configuration
SECRET_KEY=smart-forest-tactical-secret-key-2026-secure
JWT_SECRET=smart-forest-jwt-hmac-sha256-key-998811
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Database URL (SQLite default for local operations, PostgreSQL for cluster)
DATABASE_URL=sqlite:///smart_forest.db

# Storage Directories
UPLOAD_FOLDER=uploads
SOS_VIDEO_FOLDER=uploads/sos_videos
FACE_CROPS_FOLDER=uploads/face_crops

# Server Ports
HOST=0.0.0.0
PORT=5000
DEBUG=True

# ML Model Paths
PERSON_DETECTION_CHECKPOINT=ml/checkpoints/person_detection/forest_person_net_best.pt
FACE_RECOGNITION_CHECKPOINT=ml/checkpoints/face_recognition/forest_face_net_best.pt

# ML Gating Thresholds
FACE_VERIFY_THRESHOLD=0.68
PERSON_DETECTION_CONF_THRESHOLD=0.35
PERSON_DETECTION_IOU_THRESHOLD=0.45
